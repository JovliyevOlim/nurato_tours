{
  "name": "travel_tour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postbuild": "react-snap --puppeteer-args=\"--no-sandbox --disable-setuid-sandbox\""
  },
  "reactSnap": {
    "source": "dist",
    "crawl": true,
    "inlineCss": true,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "include": [
      "/",
      "/mountains",
      "/booking",
      "/contact",
      "/guesthouse",
      "/info",
      "/riding",
      "/gorge",
      "/desert",
      "/mountains"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "last 2 versions"
  ],
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-react": "^7.27.1",
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "react-snap": "^1.23.0",
    "sass": "^1.90.0",
    "vite": "^7.1.2",
    "vite-plugin-babel": "^1.3.2"
  }
}
